  "solver": {
    "kind": "dice",
    "parameters": {
      "schedule": [
        [
          0,
          0.0001
        ],
        [
          3,
          1e-05
        ]
      ],
      "sampleN": 200,
      "DoRDM": true,
      "noio": true
    },
    "convergence": {
      "maxiter": 12,
      "epsilon2": 1e-07,

  "molecule": {
    "charge": -2,
    "multiplicity": 5,
    "geometry": {
      "units": "angstrom",
      "comment": "Td, Fe-Cl 2.30 A.",
      "xyz": "Fe   0.0000000   0.0000000   0.0000000\nCl   1.3279056   1.3279056   1.3279056\nCl   1.3279056  -1.3279056  -1.3279056\nCl  -1.3279056   1.3279056  -1.3279056\nCl  -1.3279056  -1.3279056   1.3279056"
    }
  },
  "reference": {
    "type": "ROHF",
    "basis": "def2SVP",
    "spherical_d": true,
    "fock_source": "gaussian",
    "scf": {
      "conver": 10
    }
  },
  "active_space": {
    "window_policy": {
      "reference_orbital": "homo",
      "n_below": 7,
      "n_above": 3,
      "sweep": [
        {
          "n_below": 4,
          "n_above": 1,
          "label": "metal 3d only"
        },
        {
          "n_below": 7,
          "n_above": 3,
          "label": "3d plus ligand sigma"
        },
        {
          "n_below": 11,
          "n_above": 6,
          "label": "3d, ligand sigma and pi"
        }
      ]
    },
    "n_orbitals": 11,
    "notes": "A quintet ROHF reference has four singly occupied orbitals, so the alpha/beta consistency check on h_eff is at its most informative here."
